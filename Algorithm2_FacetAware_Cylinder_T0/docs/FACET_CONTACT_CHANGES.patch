+C     FACET CLOSEST-POINT SEARCH. DO NOT SELECT TARGET VIA VERTEX.
+C     FOR EACH HITTING NODE, TEST ALL ACTIVE CANDIDATE FACES.
+C     IF A HIT IS EXACTLY A VERTEX ON A FACE, SKIP THAT SELF-FACE.
+      DO K1=1,NCOUNT_A
+        TFLAG(K1)=0
+        XH=XHITTING(K1)
+        YH=YHITTING(K1)
+        ZH=ZHITTING(K1)
+        NDIS=HUGE(NDIS)
+        M=0
+        DO ND=1,NSEG
+          IF(NCSEG(ND).EQ.0) CYCLE
+          DO K2=1,4
+            XC(K2)=XSEG(K2,ND)
+            YC(K2)=YSEG(K2,ND)
+            ZC(K2)=ZSEG(K2,ND)
+          ENDDO
+          IF (IDX.NE.0) THEN
+            DO K2=1,4
+              TEMP=(XH-XC(K2))**2+(YH-YC(K2))**2
+     1             +(ZH-ZC(K2))**2
+              IF(TEMP.LT.1.0D-20) EXIT
+            ENDDO
+            IF(K2.LE.4) CYCLE
+          ENDIF
+          CALL SAFE_QUAD_PROJECT(XC,YC,ZC,XH,YH,ZH,
+     1                            ZI,ET,TEMP)
+          IF(TEMP.LT.NDIS) THEN
+            NDIS=TEMP
+            M=ND
+            CZI(K1)=ZI
+            CET(K1)=ET
+          ENDIF
+        ENDDO
+        IF(M.EQ.0) THEN
+          WRITE(*,*) 'FEM_CONTACT_NO_NONLOCAL_TARGET',K1,IDX
+          STOP 97
+        ENDIF
+        CSEG(K1)=M
+        TFLAG(K1)=1
+        DO K2=1,4
+          XC(K2)=XSEG(K2,M)
+          YC(K2)=YSEG(K2,M)
+          ZC(K2)=ZSEG(K2,M)
+        ENDDO
+        ZI=CZI(K1)
+        ET=CET(K1)
+        CALL DIR_VECTOR(XC,YC,ZC,PT_N1,PT_N2,PT_N3,ZI,ET)
+        DO M1=1,3
+          N1(M1,K1)=PT_N1(M1)
+          N2(M1,K1)=PT_N2(M1)
+          N3(M1,K1)=PT_N3(M1)
+        ENDDO
+      ENDDO
 
